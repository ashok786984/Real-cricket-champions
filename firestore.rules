rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.matchesPlayed is int && data.matchesPlayed >= 0 && data.matchesPlayed <= 100000 &&
             data.matchesWon is int && data.matchesWon >= 0 && data.matchesWon <= 100000 &&
             data.totalRuns is int && data.totalRuns >= 0 && data.totalRuns <= 10000000 &&
             data.totalWickets is int && data.totalWickets >= 0 && data.totalWickets <= 100000 &&
             data.highScore is int && data.highScore >= 0 && data.highScore <= 1000 &&
             data.sixesHit is int && data.sixesHit >= 0 && data.sixesHit <= 100000 &&
             data.foursHit is int && data.foursHit >= 0 && data.foursHit <= 100000 &&
             data.careerLevel is int && data.careerLevel >= 1 && data.careerLevel <= 100 &&
             data.rating is int && data.rating >= 0 && data.rating <= 10000 &&
             data.preferredTeamId is string && data.preferredTeamId.size() >= 1 && data.preferredTeamId.size() <= 40 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMatchRecord(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.mode is string && data.mode in ['QUICK', 'T20', 'ODI', 'TEST', 'WORLD_CUP', 'FRANCHISE', 'CAREER', 'PRACTICE', 'TOURNAMENT', 'ONLINE'] &&
             data.homeTeam is string && data.homeTeam.size() >= 1 && data.homeTeam.size() <= 40 &&
             data.awayTeam is string && data.awayTeam.size() >= 1 && data.awayTeam.size() <= 40 &&
             data.homeScore is string && data.homeScore.size() >= 1 && data.homeScore.size() <= 30 &&
             data.awayScore is string && data.awayScore.size() >= 1 && data.awayScore.size() <= 30 &&
             data.resultSummary is string && data.resultSummary.size() >= 1 && data.resultSummary.size() <= 120 &&
             data.won is bool &&
             data.playerRuns is int && data.playerRuns >= 0 && data.playerRuns <= 2000 &&
             data.playerWickets is int && data.playerWickets >= 0 && data.playerWickets <= 20 &&
             data.stadiumName is string && data.stadiumName.size() >= 1 && data.stadiumName.size() <= 60 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.teamCode is string && data.teamCode.size() >= 2 && data.teamCode.size() <= 6 &&
             data.rating is int && data.rating >= 0 && data.rating <= 10000 &&
             data.matchesWon is int && data.matchesWon >= 0 && data.matchesWon <= 100000 &&
             data.totalRuns is int && data.totalRuns >= 0 && data.totalRuns <= 10000000 &&
             data.sixesHit is int && data.sixesHit >= 0 && data.sixesHit <= 100000 &&
             data.publicVisible is bool &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidOnlineRoom(data) {
      return data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 &&
             data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 50 &&
             data.guestUid is string && data.guestUid.size() <= 128 &&
             data.guestName is string && data.guestName.size() <= 50 &&
             data.participantUids is list && data.participantUids.size() >= 1 && data.participantUids.size() <= 2 &&
             data.participantUids[0] is string &&
             data.status in ['WAITING', 'IN_PROGRESS', 'FINISHED'] &&
             data.format in ['QUICK_5', 'T20', 'SUPER_OVER'] &&
             data.oversLimit is int && data.oversLimit >= 1 && data.oversLimit <= 20 &&
             data.stadiumId is string && data.stadiumId.size() >= 1 && data.stadiumId.size() <= 40 &&
             data.hostTeamId is string && data.hostTeamId.size() >= 1 && data.hostTeamId.size() <= 40 &&
             data.guestTeamId is string && data.guestTeamId.size() >= 1 && data.guestTeamId.size() <= 40 &&
             data.currentInnings is int && data.currentInnings >= 1 && data.currentInnings <= 2 &&
             data.battingSide in ['HOST', 'GUEST'] &&
             data.hostRuns is int && data.hostRuns >= 0 && data.hostRuns <= 999 &&
             data.hostWickets is int && data.hostWickets >= 0 && data.hostWickets <= 10 &&
             data.hostBalls is int && data.hostBalls >= 0 && data.hostBalls <= 120 &&
             data.guestRuns is int && data.guestRuns >= 0 && data.guestRuns <= 999 &&
             data.guestWickets is int && data.guestWickets >= 0 && data.guestWickets <= 10 &&
             data.guestBalls is int && data.guestBalls >= 0 && data.guestBalls <= 120 &&
             data.lastBallEvent is string && data.lastBallEvent.size() <= 160 &&
             data.pendingDelivery is string && data.pendingDelivery.size() <= 80 &&
             data.turnNumber is int && data.turnNumber >= 0 && data.turnNumber <= 500 &&
             data.winnerUid is string && data.winnerUid.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'matchesPlayed', 'matchesWon',
                         'totalRuns', 'totalWickets', 'highScore', 'sixesHit',
                         'foursHit', 'careerLevel', 'rating', 'preferredTeamId',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'matchesPlayed', 'matchesWon',
                         'totalRuns', 'totalWickets', 'highScore', 'sixesHit',
                         'foursHit', 'careerLevel', 'rating', 'preferredTeamId',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'matchesPlayed', 'matchesWon',
                         'totalRuns', 'totalWickets', 'highScore', 'sixesHit',
                         'foursHit', 'careerLevel', 'rating', 'preferredTeamId',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /matchHistory/{matchId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(matchId);
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(matchId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'mode', 'homeTeam', 'awayTeam',
                           'homeScore', 'awayScore', 'resultSummary', 'won',
                           'playerRuns', 'playerWickets', 'stadiumName', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'mode', 'homeTeam', 'awayTeam',
                           'homeScore', 'awayScore', 'resultSummary', 'won',
                           'playerRuns', 'playerWickets', 'stadiumName', 'createdAt'
                         ]) &&
                         isValidMatchRecord(incoming());

        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(matchId);
      }
    }

    match /leaderboard/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && existing().publicVisible == true;
      allow list: if isSignedIn() && resource.data.publicVisible == true;

      allow create: if isSignedIn() &&
                       request.auth.uid == entryId &&
                       isValidId(entryId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'teamCode', 'rating',
                         'matchesWon', 'totalRuns', 'sixesHit', 'publicVisible', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'teamCode', 'rating',
                         'matchesWon', 'totalRuns', 'sixesHit', 'publicVisible', 'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == entryId &&
                       isValidId(entryId) &&
                       incoming().userId == existing().userId &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'teamCode', 'rating',
                         'matchesWon', 'totalRuns', 'sixesHit', 'publicVisible', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && request.auth.uid == entryId && isValidId(entryId);
    }

    match /onlineRooms/{roomId} {
      allow get: if isSignedIn() &&
                    isValidId(roomId) &&
                    (existing().status == 'WAITING' || request.auth.uid in existing().participantUids);

      allow list: if isSignedIn() &&
                     (resource.data.status == 'WAITING' || request.auth.uid in resource.data.participantUids);

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().guestUid == '' &&
                       incoming().status == 'WAITING' &&
                       incoming().participantUids.size() == 1 &&
                       incoming().participantUids[0] == request.auth.uid &&
                       incoming().hostRuns == 0 &&
                       incoming().hostWickets == 0 &&
                       incoming().hostBalls == 0 &&
                       incoming().guestRuns == 0 &&
                       incoming().guestWickets == 0 &&
                       incoming().guestBalls == 0 &&
                       incoming().turnNumber == 0 &&
                       incoming().keys().hasAll([
                         'roomCode', 'hostUid', 'hostName', 'guestUid', 'guestName',
                         'participantUids', 'status', 'format', 'oversLimit', 'stadiumId',
                         'hostTeamId', 'guestTeamId', 'currentInnings', 'battingSide',
                         'hostRuns', 'hostWickets', 'hostBalls',
                         'guestRuns', 'guestWickets', 'guestBalls',
                         'lastBallEvent', 'pendingDelivery', 'turnNumber', 'winnerUid',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'roomCode', 'hostUid', 'hostName', 'guestUid', 'guestName',
                         'participantUids', 'status', 'format', 'oversLimit', 'stadiumId',
                         'hostTeamId', 'guestTeamId', 'currentInnings', 'battingSide',
                         'hostRuns', 'hostWickets', 'hostBalls',
                         'guestRuns', 'guestWickets', 'guestBalls',
                         'lastBallEvent', 'pendingDelivery', 'turnNumber', 'winnerUid',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidOnlineRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidOnlineRoom(incoming()) &&
                       existing().status != 'FINISHED' &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().format == existing().format &&
                       incoming().oversLimit == existing().oversLimit &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Guest joins WAITING room
                         (existing().status == 'WAITING' &&
                          existing().hostUid != request.auth.uid &&
                          incoming().guestUid == request.auth.uid &&
                          incoming().participantUids.size() == 2 &&
                          incoming().participantUids[0] == existing().hostUid &&
                          incoming().participantUids[1] == request.auth.uid &&
                          incoming().status == 'IN_PROGRESS' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'guestUid', 'guestName', 'guestTeamId', 'participantUids',
                            'status', 'lastBallEvent', 'updatedAt'
                          ]))
                         ||
                         // Action 2: Synchronized ball/turn update by participant with authoritative score bounds
                         (existing().status == 'IN_PROGRESS' &&
                          request.auth.uid in existing().participantUids &&
                          incoming().guestUid == existing().guestUid &&
                          incoming().participantUids == existing().participantUids &&
                          incoming().hostRuns >= existing().hostRuns &&
                          incoming().hostRuns <= existing().hostRuns + 7 &&
                          incoming().guestRuns >= existing().guestRuns &&
                          incoming().guestRuns <= existing().guestRuns + 7 &&
                          incoming().hostWickets >= existing().hostWickets &&
                          incoming().hostWickets <= existing().hostWickets + 1 &&
                          incoming().guestWickets >= existing().guestWickets &&
                          incoming().guestWickets <= existing().guestWickets + 1 &&
                          incoming().hostBalls >= existing().hostBalls &&
                          incoming().hostBalls <= existing().hostBalls + 1 &&
                          incoming().guestBalls >= existing().guestBalls &&
                          incoming().guestBalls <= existing().guestBalls + 1 &&
                          incoming().turnNumber >= existing().turnNumber &&
                          incoming().turnNumber <= existing().turnNumber + 1 &&
                          incoming().status in ['IN_PROGRESS', 'FINISHED'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'currentInnings', 'battingSide',
                            'hostRuns', 'hostWickets', 'hostBalls',
                            'guestRuns', 'guestWickets', 'guestBalls',
                            'lastBallEvent', 'pendingDelivery', 'turnNumber',
                            'status', 'winnerUid', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() &&
                       isValidId(roomId) &&
                       existing().hostUid == request.auth.uid &&
                       existing().status == 'WAITING';
    }
  }
}
